# Required on Vercel (get for $0 from Vercel Marketplace -> Neon Postgres or Supabase)
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Required on Vercel (any random 32+ character string, e.g. generated with `openssl rand -hex 32`)
SESSION_SECRET=replace-with-a-long-random-secret-key

# Optional ($0 free tier on Vercel Blob — if omitted, validated <=2MB photos save directly in Postgres)
# BLOB_READ_WRITE_TOKEN=
